{
  // What n8n loads is CommonJS: its loader `require()`s each path in package.json's `n8n` section.
  // So this is the n8n-node template's compiler setup, standalone rather than extending the shared
  // config, whose `Bundler` resolution cannot be combined with `module: commonjs`. `tsconfig.json`
  // beside it is the typecheck.
  // `incremental` is off, unlike the template: its build info would land in `dist/` and ship.
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2019",
    "lib": ["es2019", "es2020", "es2022.error"],
    "removeComments": true,
    "useUnknownInCatchVariables": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "preserveConstEnums": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "./dist/"
  },
  "include": ["credentials/**/*.ts", "nodes/**/*.ts"]
}
